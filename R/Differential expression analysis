# ====================================================================================================================
# BIG DATA VERSION - Handles 10,000+ samples
# ====================================================================================================================

library(DESeq2)
library(data.table)  # Fast CSV
library(PCAtools)    # Fast PCA
library(Matrix)      # Sparse matrices

# ====================================================================================================================
# 1. Memory-efficient data loading
# ====================================================================================================================

# For huge datasets, don't load all at once
# Use fread() instead of read.csv()
counts_matrix <- fread("huge_counts.csv.gz")  # Reads compressed files
counts_matrix <- as.matrix(counts_matrix, rownames = 1)  # Convert to matrix

# ====================================================================================================================
# 2. DESeq2 on big data (same code works!)
# ====================================================================================================================

dds <- DESeqDataSetFromMatrix(
  countData = counts_matrix,
  colData = metadata,
  design = ~ condition
)

# This line handles big data internally
dds <- DESeq(dds)  # Uses optimized C++ code

# ====================================================================================================================
# 3. Faster results extraction
# ====================================================================================================================

# Use 'tidy = TRUE' for data.table compatibility
res <- results(dds, tidy = TRUE)  
setDT(res)  # Convert to data.table for speed

# Filter efficiently
sig_genes <- res[padj < 0.05 & abs(log2FoldChange) > 1, ]

# ====================================================================================================================
# 4. Memory-efficient PCA
# ====================================================================================================================

vst_counts <- assay(vst(dds))

# PCAtools is 10x faster than prcomp()
pca_result <- pca(vst_counts, 
                  removeVar = 0.8,  # Remove 80% low-variance genes
                  scale = TRUE)

# Plot (still works)
biplot(pca_result)

# ====================================================================================================================
# 5. Fast visualization for big data
# ====================================================================================================================

# For 1000+ samples, use rasterized plots
library(ggplot2)

volcano_plot <- ggplot(res, aes(x = log2FoldChange, 
                                 y = -log10(padj))) +
  geom_point(alpha = 0.3, size = 0.5, raster = TRUE) +  # raster = TRUE saves memory
  theme_minimal()

# ====================================================================================================================
# 6. Save results efficiently
# ====================================================================================================================

# Compressed CSV (10x smaller)
fwrite(res, "DE_results.csv.gz")

# Or Parquet (best for big data)
library(arrow)
write_parquet(res, "DE_results.parquet")

# For sharing with non-R users, save as HDF5
library(rhdf5)
h5write(as.matrix(res), "DE_results.h5", "results")
