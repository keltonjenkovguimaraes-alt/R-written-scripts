# ============================================
# Differential Expression Analysis
# Goal: Find genes responding to dexamethasone treatment
# ============================================

# Load libraries
library(DESeq2)
library(airway)
library(ggplot2)
library(dplyr)
library(pheatmap)
library(clusterProfiler)
library(org.Hs.eg.db)

# Load data
data(airway)
counts <- assay(airway)
metadata <- as.data.frame(colData(airway))

# ============================================
# Step 1: Create DESeq2 object and run analysis
# ============================================

# Create DESeq2 dataset
# Design formula: model expression as ~ cell line + treatment
dds <- DESeqDataSet(airway, design = ~ cell + dex)

# Run the differential expression pipeline
dds <- DESeq(dds)

# Extract results (trt vs untrt)
res <- results(dds, contrast = c("dex", "trt", "untrt"))

# Order by adjusted p-value
res <- res[order(res$padj), ]

# ============================================
# Step 2: Explore the results
# ============================================

# Summary of results
summary(res)

# How many significant genes?
sig_genes <- res[!is.na(res$padj) & res$padj < 0.05 & abs(res$log2FoldChange) > 1, ]
n_sig <- nrow(sig_genes)
print(paste("Number of significant genes (|log2FC| > 1, padj < 0.05):", n_sig))

# Top 10 most significant genes
top10 <- head(res, 10)
print("Top 10 most significant genes:")
print(top10)

# ============================================
# Step 3: Visualization
# ============================================

# 3A: Volcano plot
res_df <- as.data.frame(res)
res_df$gene <- rownames(res_df)
res_df$significant <- ifelse(!is.na(res_df$padj) & 
                               res_df$padj < 0.05 & 
                               abs(res_df$log2FoldChange) > 1, 
                             "Significant", "Not Significant")

volcano_plot <- ggplot(res_df, aes(x = log2FoldChange, 
                                   y = -log10(padj), 
                                   color = significant)) +
  geom_point(alpha = 0.6, size = 1) +
  scale_color_manual(values = c("Not Significant" = "gray", 
                                "Significant" = "red")) +
  theme_minimal() +
  labs(title = "Differential Expression: Dexamethasone Treatment",
       x = "log2 Fold Change (Treatment vs Control)",
       y = "-log10(Adjusted P-value)") +
  geom_vline(xintercept = c(-1, 1), linetype = "dashed", color = "blue") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed", color = "blue") +
  theme(legend.position = "bottom")

print(volcano_plot)

# 3B: MA plot (log fold change vs mean expression)
ma_plot <- ggplot(res_df, aes(x = baseMean, y = log2FoldChange, color = significant)) +
  geom_point(alpha = 0.6, size = 1) +
  scale_x_log10() +
  scale_color_manual(values = c("Not Significant" = "gray", 
                                "Significant" = "red")) +
  theme_minimal() +
  labs(title = "MA Plot",
       x = "Mean of Normalized Counts (log scale)",
       y = "log2 Fold Change") +
  geom_hline(yintercept = 0, linetype = "solid", color = "black") +
  theme(legend.position = "bottom")

print(ma_plot)

# 3C: Heatmap of top 30 significant genes
top30_genes <- rownames(head(sig_genes[order(sig_genes$log2FoldChange, decreasing = TRUE), ], 30))
vst_counts <- assay(vst(dds))  # Variance stabilized counts

heatmap_data <- vst_counts[top30_genes, ]
annotation_col <- data.frame(
  Treatment = metadata$dex,
  CellLine = metadata$cell
)
rownames(annotation_col) <- colnames(vst_counts)

pheatmap(heatmap_data,
         scale = "row",
         annotation_col = annotation_col,
         show_rownames = TRUE,
         main = "Top 30 Differentially Expressed Genes",
         fontsize_row = 8,
         clustering_distance_rows = "correlation",
         color = colorRampPalette(c("blue", "white", "red"))(50))

# ============================================
# Step 4: Find most upregulated and downregulated genes
# ============================================

# Most upregulated (positive log2FC)
upregulated <- sig_genes[order(sig_genes$log2FoldChange, decreasing = TRUE), ]
top_up <- head(upregulated, 10)
print("Top 10 upregulated genes:")
print(top_up[, c("log2FoldChange", "padj")])

# Most downregulated (negative log2FC)
downregulated <- sig_genes[order(sig_genes$log2FoldChange, decreasing = FALSE), ]
top_down <- head(downregulated, 10)
print("Top 10 downregulated genes:")
print(top_down[, c("log2FoldChange", "padj")])

# ============================================
# Step 5: Export results
# ============================================

# Save full results
write.csv(as.data.frame(res), "DE_results_all_genes.csv")

# Save only significant genes
write.csv(as.data.frame(sig_genes), "DE_results_significant.csv")

# Save top up/downregulated
write.csv(as.data.frame(top_up), "top_10_upregulated.csv")
write.csv(as.data.frame(top_down), "top_10_downregulated.csv")

# ============================================
# Step 6: Simple interpretation (without external DB)
# ============================================

# Look at a known dexamethasone-responsive gene: ZBTB16
# (Zinc finger and BTB domain containing 16)
if("ENSG00000109906" %in% rownames(res)) {
  zbtb16_res <- res["ENSG00000109906", ]
  print("Known dexamethasone target: ZBTB16")
  print(paste("  log2 Fold Change:", round(zbtb16_res$log2FoldChange, 3)))
  print(paste("  Adjusted P-value:", format(zbtb16_res$padj, scientific = TRUE)))
}

